# ============================================================
# GoShare Backend — Environment Configuration
# ============================================================

# Server Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Server Port (Render, Railway, Fly.io, Heroku automatically set PORT)
PORT=5000

# CORS Allowed Origin(s)
# In production, set to your frontend domain (or comma-separated list of domains)
# Example: https://goshare.vercel.app,https://goshare-admin.vercel.app
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Supabase PostgreSQL Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ============================================================

# Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (used for client authentication)
SUPABASE_ANON_KEY=your-anon-key-here

# Secret Service Role Key (used for admin/server-side operations — NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
